{
  "$comment": "A settings.json you can copy and have work. Every path and command here resolves after ./scripts/bootstrap.sh runs. The permissions allowlist is omitted because it accumulates per-project entries; secrets are placeholders. See config/README.md for what changed and why.",
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "captains-log@my-claude-tools": true,
    "dev-diary@my-claude-tools": true,
    "claude-workflows@my-claude-tools": true,
    "superpowers@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-mem@thedotmack": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
